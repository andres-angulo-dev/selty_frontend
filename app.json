{
  "expo": {
    "name": "sialty",
    "slug": "sialty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sialty.app"
    },
    "android": {
      "package": "com.sialty.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sialty utilise votre position pour afficher les professionnels proches de vous et la distance qui vous sépare."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sialty a besoin d'accéder à vos photos pour illustrer vos annonces et offres.",
          "cameraPermission": "Sialty a besoin de l'appareil photo pour photographier vos réalisations.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
