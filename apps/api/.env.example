# Copy to .env (never committed) and adjust.
# Development values only: the local database password is never reused anywhere.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://sialty:sialty@localhost:5432/sialty_dev
# Proxies in front of the API: 1 when the iPhone goes through the cloudflared tunnel
TRUST_PROXY_HOPS=1
# Photo files, relative to apps/api (git-ignored)
STORAGE_DIR=storage
# Signs sessions, 32 characters minimum, required. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
# Hosts the API may be reached on (comma list; the tunnel address changes at each start)
AUTH_ALLOWED_HOSTS=localhost:4000,127.0.0.1:4000,*.trycloudflare.com
# Base URL used when the request host is not allowed
AUTH_FALLBACK_URL=http://localhost:4000
# Headers holding the client address, in order (comma list)
AUTH_IP_HEADERS=cf-connecting-ip
# SMTP server for the sign-in codes (local catcher in development)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Sender shown on the e-mails
MAIL_FROM=Sialty <no-reply@sialty.test>
